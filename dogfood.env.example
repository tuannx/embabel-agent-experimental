# Copy to dogfood.env and fill the key. dogfood.env is gitignored.
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DOGFOOD_MODEL=deepseek-v4-flash
DOGFOOD_DSL_ENABLED=true
DOGFOOD_DSL_STEPS_LOCATION=classpath:/steps
DOGFOOD_DSL_AGENT_NAME=oss-java-kotlin-expert
DOGFOOD_DSL_GOAL=produceDogfoodReport
DOGFOOD_MAX_OUTPUT_TOKENS=384000
DOGFOOD_LLM_TIMEOUT=10m
DOGFOOD_LLM_MAX_ATTEMPTS=3
DOGFOOD_MEMORY_ENABLED=true
# GitHub: use ./scripts/dogfood-run.sh — auto-injects GH_TOKEN from `gh auth login` (no manual token).
# Optional override: DOGFOOD_MEMORY_GITHUB_REPO=owner/repo
DOGFOOD_MEMORY_GITHUB_ENABLED=true
DOGFOOD_DEBUG=true
# After dogfood, host may open a draft PR when decision is RAISE_PR:
# DOGFOOD_PUBLICATION_AUTO_RAISE_PR=true
# NEEDS_WORK improve loop (host): plan → dogfood-improve.sh → re-dogfood
# DOGFOOD_AUTO_IMPROVE=true
# DOGFOOD_IMPROVE_MAX_ITERATIONS=2
# DOGFOOD_IMPROVE_INVOKE_CURSOR=false
DOGFOOD_TASK=As a top 1% OSS Java/Kotlin engineer, dogfood this Embabel experimental repo: review code, gate against contributor principles, and draft concise GitHub interactions.
